# Copy to .env for local runs. In production these are set in the Dokploy environment.

# Meta Model API (primary provider)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Provider switches: meta | assemblyai (assemblyai is an interim fallback, see docs/DECISIONS.md)
LLM_PROVIDER=meta
ASR_PROVIDER=meta
ASSEMBLYAI_API_KEY=

# Baseten (Muse Spark Open): critique pass and evaluation on public evidence
BASETEN_API_KEY=
# Triage controls: execution code for every run, daily cap, batch limit, budget per scheduled run
EXECUTION_CODE=
TRIAGE_DAILY_CAP=30
TRIAGE_BATCH_LIMIT=5
TRIAGE_BUDGET_PER_RUN=2

# NASA FIRMS
FIRMS_MAP_KEY=

# Map display: maplibre | google
MAP_PROVIDER=maplibre
GOOGLE_MAPS_KEY=

# WhatsApp Cloud API (citizen reports and verifier buttons)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_VERIFIER_NUMBERS=

# Verifier actions on the dashboard
VERIFIER_TOKEN=

# Runtime
DATA_DIR=./data
FIXTURE_MODE=true
SCHEDULER_ENABLED=false
FIRMS_POLL_MINUTES=30
